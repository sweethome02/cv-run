<Window x:Class="ClipNestWpf.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="32" Height="64"
        WindowStyle="None" AllowsTransparency="True"
        Background="#01FFFFFF"
        Topmost="True" ShowInTaskbar="False"
        Opacity="0.7">
    <Grid Name="RootGrid" Background="Transparent"
          MouseEnter="OnMouseEnter"
          MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="OnMouseDown"
          MouseLeftButtonUp="OnMouseUp"
          MouseRightButtonUp="OnMouseUp"
          MouseMove="OnMouseMove"
          RenderTransformOrigin="0,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="0.8" ScaleY="0.8"/>
        </Grid.RenderTransform>
        <Path x:Name="SemiPath" Stroke="#88FFFFFF" StrokeThickness="2" Fill="Transparent"/>
        <TextBlock Text="CV" FontSize="14" FontWeight="Bold"
                   Foreground="#1A1A1A"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
