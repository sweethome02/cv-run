<Window x:Class="ClipNestWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="540"
        MaxWidth="800" MaxHeight="900"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged"
        MouseLeave="Window_MouseLeave"
        MouseEnter="Window_MouseEnter"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">
    <Border Name="RootBorder" Background="#1E1E24" CornerRadius="16"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#282830">
                <TextBlock Text="粘贴板" Foreground="#D0D0D8" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Name="CountLabel" Foreground="#686878" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Name="ClearAllBtn" Content="清空" Foreground="#A0A0A8"
                            Background="Transparent" BorderBrush="#484850" BorderThickness="1"
                            FontSize="11" Padding="6,2" Cursor="Hand"
                            Click="ClearAllBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Search box -->
            <Grid Grid.Row="1" Margin="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="SearchBox" Grid.Column="0"
                         Background="#2A2A34" Foreground="#D0D0D8"
                         BorderBrush="#3A3A44" BorderThickness="1"
                         CaretBrush="#D0D0D8"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Name="ClearSearchBtn" Grid.Column="1" Content="✕"
                        Foreground="#787878" Background="Transparent"
                        BorderThickness="0" FontSize="14" Padding="6,2"
                        Cursor="Hand" Visibility="Collapsed"
                        Click="ClearSearchBtn_Click"/>
            </Grid>

            <!-- Item list -->
            <Grid Grid.Row="2" Margin="6,0,6,6">
                <ListBox Name="ItemList"
                         Background="Transparent" Foreground="#D0D0D8"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ItemList_MouseDoubleClick"
                         MouseRightButtonUp="ListBox_RightBtnUp"
                          ItemsSource="{Binding}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Margin="2" CornerRadius="6" Padding="10,6" Name="Bd">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                                <TextBlock FontSize="11" Foreground="#787888" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TypeLabel}"/><Run Text=" · "/>
                                                    <Run Text="{Binding TimeStr}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="✕" FontSize="14" Foreground="#585868"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       MouseLeftButtonDown="DeleteClick" Cursor="Hand"
                                                       ToolTip="删除"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A34"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4A6FA5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" Visibility="Collapsed"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Name="EmptyHint" Text="暂无信息"
                           Foreground="#585858" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
